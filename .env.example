PORT=4000
NODE_ENV=development

# The public URL of the frontend application, used for CORS and redirects.
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Authentication Secrets (generate with `openssl rand -hex 32`)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudflare R2 Media Storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=zira-media
CLOUDFLARE_R2_PUBLIC_URL=

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Service (Optional - for password reset, notifications)
EMAIL_FROM=
EMAIL_PROVIDER=
EMAIL_API_KEY=

ADMIN_EMAIL=

# Web Push VAPID Keys (generate with `npm run vapid:generate`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@zira.stream"