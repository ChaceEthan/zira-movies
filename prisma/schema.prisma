// Prisma Schema for ZIRA Platform (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum ContentState {
  DRAFT
  UPLOADED
  PROCESSING
  READY
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum RightsStatus {
  OWNED
  LICENSED
  PERMISSION_GRANTED
  PUBLIC_DOMAIN
  PENDING_VERIFICATION
  EXPIRED
}

enum AdPlacementType {
  HOME_BETWEEN_RAILS
  HOME_BOTTOM_BANNER
  BROWSE_BANNER
  SEARCH_NATIVE
  MOVIE_DETAILS_BANNER
  SERIES_DETAILS_BANNER
  PLAYER_COMPANION
  FOOTER_BANNER
}

enum CampaignPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum QualityRendition {
  AUTO
  P1080
  P720
  P480
  P360
  HLS
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?
  displayName        String
  avatar             String?
  role               Role     @default(USER)
  emailVerified      Boolean  @default(false)
  playbackPreference String   @default("AUTO") // AUTO, DATA_SAVER, HIGH_QUALITY
  notificationEmail  Boolean  @default(true)
  notificationPush   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  watchProgress WatchProgress[]
  watchHistory  WatchHistory[]
  watchlist     Watchlist[]
  ratings       Rating[]
  notifications Notification[]
  auditLogs     AdminAuditLog[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Genre {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  movieGenres  MovieGenre[]
  seriesGenres SeriesGenre[]
}

model CastMember {
  id        String  @id @default(uuid())
  name      String
  role      String?
  avatarUrl String?
  bio       String?
}

model Movie {
  id                 String       @id @default(uuid())
  title              String
  slug               String       @unique
  description        String
  releaseYear        Int
  durationMinutes    Int
  maturityRating     String       @default("PG-13") // G, PG, PG-13, R, 18+
  language           String       @default("English")
  subtitlesAvailable String[]
  isFeatured         Boolean      @default(false)
  isTrending         Boolean      @default(false)
  isRwandanContent   Boolean      @default(false)
  isAfricanContent   Boolean      @default(false)
  isTop10            Boolean      @default(false)
  top10Rank          Int?
  viewCount          Int          @default(0)
  likeCount          Int          @default(0)
  averageRating      Float        @default(0)
  state              ContentState @default(DRAFT)

  posterUrl   String?
  backdropUrl String?
  trailerUrl  String?
  videoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movieGenres   MovieGenre[]
  contentRights ContentRights?
  videoAssets   VideoAsset[]
  watchProgress WatchProgress[]
  watchHistory  WatchHistory[]
  watchlist     Watchlist[]
  ratings       Rating[]
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model Series {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  description      String
  releaseYear      Int
  maturityRating   String       @default("PG-13")
  language         String       @default("English")
  isFeatured       Boolean      @default(false)
  isTrending       Boolean      @default(false)
  isRwandanContent Boolean      @default(false)
  isAfricanContent Boolean      @default(false)
  isTop10          Boolean      @default(false)
  top10Rank        Int?
  viewCount        Int          @default(0)
  averageRating    Float        @default(0)
  state            ContentState @default(DRAFT)

  posterUrl   String?
  backdropUrl String?
  trailerUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons       Season[]
  seriesGenres  SeriesGenre[]
  contentRights ContentRights?
  watchlist     Watchlist[]
  ratings       Rating[]
}

model SeriesGenre {
  seriesId String
  genreId  String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
}

model Season {
  id           String    @id @default(uuid())
  seriesId     String
  seasonNumber Int
  title        String
  description  String?
  series       Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([seriesId, seasonNumber])
}

model Episode {
  id              String          @id @default(uuid())
  seasonId        String
  episodeNumber   Int
  title           String
  description     String
  durationMinutes Int
  thumbnailUrl    String?
  videoUrl        String?
  state           ContentState    @default(DRAFT)
  season          Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchProgress   WatchProgress[]
  watchHistory    WatchHistory[]
  videoAssets     VideoAsset[]

  @@unique([seasonId, episodeNumber])
}

model ContentRights {
  id               String       @id @default(uuid())
  movieId          String?      @unique
  seriesId         String?      @unique
  rightsStatus     RightsStatus @default(PENDING_VERIFICATION)
  rightsHolder     String
  licenseReference String?
  territories      String[]     @default(["GLOBAL"])
  rightsStartDate  DateTime
  rightsEndDate    DateTime?
  internalNotes    String?
  movie            Movie?       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series           Series?      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
}

model VideoAsset {
  id           String           @id @default(uuid())
  movieId      String?
  episodeId    String?
  status       String           @default("READY") // UPLOADED, QUEUED, PROCESSING, READY, FAILED
  sourceKey    String
  hlsMasterKey String?
  movie        Movie?           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode      Episode?         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  renditions   VideoRendition[]
  subtitles    SubtitleTrack[]
}

model VideoRendition {
  id           String           @id @default(uuid())
  videoAssetId String
  rendition    QualityRendition
  url          String
  bitrate      Int?
  resolution   String?
  videoAsset   VideoAsset       @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
}

model SubtitleTrack {
  id           String     @id @default(uuid())
  videoAssetId String
  language     String // e.g., "en", "rw", "fr", "sw"
  label        String // e.g., "English", "Kinyarwanda", "Français", "Kiswahili"
  url          String
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
}

model WatchProgress {
  id              String   @id @default(uuid())
  userId          String
  movieId         String?
  episodeId       String?
  positionSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  percentage      Float    @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, episodeId])
}

model WatchHistory {
  id        String   @id @default(uuid())
  userId    String
  movieId   String?
  episodeId String?
  watchedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  movieId   String?
  seriesId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, seriesId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   String?
  seriesId  String?
  score     Int // 1 to 5 stars or 1 to 10
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, seriesId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // NEW_RELEASE, SYSTEM, WATCHLIST_UPDATE
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id           String            @id @default(uuid())
  name         String
  logoUrl      String?
  websiteUrl   String
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  campaigns    SponsorCampaign[]
}

model SponsorCampaign {
  id                    String                @id @default(uuid())
  sponsorId             String
  name                  String
  startDate             DateTime
  endDate               DateTime
  active                Boolean               @default(true)
  budgetNote            String?
  internalPaymentStatus CampaignPaymentStatus @default(UNPAID)
  placement             AdPlacementType       @default(HOME_BETWEEN_RAILS)
  destinationUrl        String
  impressionLimit       Int?
  clickLimit            Int?
  sponsor               Sponsor               @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  creatives             AdCreative[]
  impressions           AdImpression[]
  clicks                AdClick[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model AdCreative {
  id           String          @id @default(uuid())
  campaignId   String
  title        String
  imageUrl     String
  tagline      String?
  callToAction String          @default("Learn More")
  campaign     SponsorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AdImpression {
  id         String          @id @default(uuid())
  campaignId String
  createdAt  DateTime        @default(now())
  ipAddress  String?
  userAgent  String?
  campaign   SponsorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AdClick {
  id         String          @id @default(uuid())
  campaignId String
  createdAt  DateTime        @default(now())
  ipAddress  String?
  userAgent  String?
  campaign   SponsorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AffiliatePartner {
  id          String              @id @default(uuid())
  partnerName String
  description String?
  websiteUrl  String
  active      Boolean             @default(true)
  campaigns   AffiliateCampaign[]
}

model AffiliateCampaign {
  id             String           @id @default(uuid())
  partnerId      String
  campaignName   String
  imageUrl       String?
  destinationUrl String
  trackingUrl    String
  placement      AdPlacementType  @default(HOME_BOTTOM_BANNER)
  startDate      DateTime
  endDate        DateTime
  active         Boolean          @default(true)
  partner        AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks         AffiliateClick[]
}

model AffiliateClick {
  id         String            @id @default(uuid())
  campaignId String
  createdAt  DateTime          @default(now())
  campaign   AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model SponsoredPlacement {
  id          String   @id @default(uuid())
  contentType String // MOVIE or SERIES
  contentId   String
  campaignId  String?
  placement   String // FEATURED, HOME_RAIL, SEARCH_PROMOTION, GENRE_PROMOTION
  startDate   DateTime
  endDate     DateTime
  priority    Int      @default(0)
  active      Boolean  @default(true)
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String // PAGE_VIEW, SEARCH, MOVIE_START, WATCH_PROGRESS, WATCH_COMPLETE, etc.
  meta      String? // JSON string
  ipAddress String?
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String // CREATE_MOVIE, PUBLISH_MOVIE, EDIT_RIGHTS, ACTIVATE_CAMPAIGN, etc.
  entityType String
  entityId   String
  metadata   String? // JSON string
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)
}
